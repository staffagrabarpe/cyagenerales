# URLs limpias para hosting Apache / cPanel
# (si el sitio corre con el Dockerfile + nginx, este archivo no se usa)
Options -MultiViews
RewriteEngine On

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /pagina.html -> /pagina  (enlaces antiguos, 301 para SEO)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /pagina -> pagina.html (internamente, sin cambiar la URL)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/?$ $1.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
